# Copy to .env (never committed) and fill in. Placeholders only in this file.

# --- chain ---
# Robinhood Chain (Arbitrum Orbit L2). mainnet 4663, testnet 46630. Gas in ETH.
CHAIN_ID=46630
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_API_KEY=

# --- contracts (forge script) ---
DEPLOYER_PRIVATE_KEY=

# --- keeper ---
# Holds KEEPER_ROLE on the AuctionHouse and nothing else. Never logged (see keeper/src/logger.ts).
KEEPER_PRIVATE_KEY=
# Overrides the two RPC URLs above. The fork harness points this at anvil.
KEEPER_RPC_URL=
# Path to the keeper's own config; defaults to ./config/keeper.<CHAIN_ID>.json
KEEPER_CONFIG=
# Overrides config.deploymentPath; defaults to ../contracts/deployments/<CHAIN_ID>.json
DEPLOYMENT_PATH=
LOG_LEVEL=info
# Simulate everything, send nothing. A dry run exercises the real decision logic.
DRY_RUN=false

# A SEPARATE key holding GUARDIAN_ROLE on the RiskModule (D-012 as amended by D-029). It can only
# pause and unpause. The keeper refuses to start if this is the same key as KEEPER_PRIVATE_KEY.
GUARDIAN_PRIVATE_KEY=
# D-020's automatic pause on a stock-token beacon or USDG implementation change. Ships disarmed:
# pausing every vault is a real, user-visible action and arming it should be deliberate.
GUARDIAN_AUTOPAUSE=false

# Where the run ledger, the volatility audit trail and status.json live.
STATE_DIR=./keeper/state
STATUS_FILE=
# Bind loopback under systemd. Under Docker set 0.0.0.0 in the container and publish to 127.0.0.1
# on the host — binding loopback inside the container makes the published port unreachable.
STATUS_HOST=127.0.0.1
STATUS_PORT=8787

# Alerts. Absent token => alerting is silently disabled and everything still reaches the log
# and status.json, so a dry run needs no credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- points ---
POINTS_DB_PATH=./points/data/points.db

# --- app (public, exposed to the browser) ---
NEXT_PUBLIC_CHAIN_ID=46630
# Blank = the chain's public RPC; http://127.0.0.1:8545 for the anvil fork (keeper `npm run week`).
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_EXPLORER_URL=
# /stake stays hidden until the token launches.
NEXT_PUBLIC_STAKE_ENABLED=false
# ISO-8601 end of the current points epoch; blank shows "not set".
NEXT_PUBLIC_POINTS_EPOCH_END=
# Server only: JSON ledger written by the points/ snapshot job (see app/src/lib/reads/points.ts).
POINTS_LEDGER_PATH=
