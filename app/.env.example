# Public, exposed to the browser.
NEXT_PUBLIC_CHAIN_ID=46630
# Leave blank for the public RPC of the chosen chain; set to http://127.0.0.1:8545 for the anvil fork.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Blockscout base URL; defaults per chain when blank.
NEXT_PUBLIC_EXPLORER_URL=
# /stake is hidden until the token launches.
NEXT_PUBLIC_STAKE_ENABLED=false
# ISO-8601, e.g. 2026-12-31T00:00:00Z. Blank = "not set" on /points.
NEXT_PUBLIC_POINTS_EPOCH_END=

# Server only. JSON ledger written by the points/ snapshot job; blank = empty state on /points.
POINTS_LEDGER_PATH=

# waitlist store (app/supabase/waitlist.sql); blank = rows go to .data/waitlist.jsonl
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: block FeeRouter was deployed at. Set only on an archive RPC / anvil to sum WriteFeePaid burns from logs.
FEE_ROUTER_FROM_BLOCK=
